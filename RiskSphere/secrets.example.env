# Copy this file to secrets.local.env and fill in the two keys.
# secrets.local.env is gitignored. Do not commit it, and do not paste a key into the readme or a log.

# Chat gateway, group 046-065. The key is the one issued for that group.
LLM_BASE_URL=https://103.42.50.41:1034/v1
LLM_MODEL=Qwen/Qwen3-8B
LLM_CA_CERT=/absolute/path/to/vm04-ca.crt
LLM_API_KEY=

# Embeddings, a different host and a different key. Leave EMBED_API_KEY blank
# and sentence ranking falls back to shared words. The planner does not call it yet.
EMBED_BASE_URL=https://103.42.50.41:1035/v1
EMBED_MODEL=bge-small-en-v1.5
EMBED_CA_CERT=/absolute/path/to/vm02-ca.crt
EMBED_API_KEY=
